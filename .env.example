# Copy to .env.local for local development, or set these as Environment
# Variables in the Vercel project settings for production/preview.
# All are optional — each feature they gate stays safely disabled until set.

# Canonical production URL. Must match the www domain hardcoded in
# lib/seo.ts, app/sitemap.ts, and app/robots.ts.
NEXT_PUBLIC_SITE_URL=https://www.lkmachinery.co.in

# Google Analytics 4 — Measurement ID from the GA4 property
# (Admin > Data Streams > your web stream). Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification code (Settings > Ownership
# verification > HTML tag > copy just the content="..." value, not the
# whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — HTML Meta Tag verification code (Settings >
# verification > copy just the content="..." value).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
